# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# PyInstaller build output
build/
dist/
*.manifest

# Generated output
etiketten_output/
pi_bi_output/
cover_cache/
cover_output/

# Runtime state (app-mutated)
config.json
paketnr.txt

# PI/BI: heavy sample binaries (keep xml + reference docx/html only)
pi_bi_generator/beispiele/**/*.pdf
pi_bi_generator/beispiele/**/*.xlsx
pi_bi_generator/beispiele/**/2D_300_*.jpg
pi_bi_generator/beispiele/**/3D_300_*.jpg
pi_bi_generator/beispiele/**/.~lock.*

# Cover-Previews: heavy local-only inputs (sample PDFs, mockup PSDs, Referenz-TIFs)
cover_previews/**/*.pdf
cover_previews/*.pdf
cover_previews/*.tif
cover_previews/mockups/*.psd
# 3D-Mockup-Vorlagen (~480 MB PSDs) — per config referenziert, nicht eingecheckt
cover_previews/_NEU_Vorlage/

# LibreOffice / Office lock files
.~lock.*#
~$*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# shopware_publisher: Produkt-Dumps (nur lokal, zum Vergleich)
shopware_publisher/beispiel_produkt.json
shopware_publisher/dump_*.json
