# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# PyInstaller build output
build/
dist/
*.manifest

# Generated output
etiketten_output/
pi_bi_output/
cover_cache/
cover_output/
mailing_output/
honorar_output/

# mailing_list_updater: Kundendaten aus Access und Lexware — personenbezogen,
# gehören nicht ins Repo. Der Ordner ist die Arbeitsablage vor Ort.
mailing_list_updater/*.xlsx

# Runtime state (app-mutated)
config.json
paketnr.txt
# honorar_abrechner: der Bestand ist eine Excel-Mappe neben der .exe — mit
# Adressen und Bankverbindungen der Autoren. Gehört nicht ins Repo.
Honorarbestand.xlsx
Honorarbestand.bak.xlsx
Honorarbestand.wiederherstellung.xlsx
honorarbestand.sperre
# Ablage des Windows-Prüfskripts (Probebriefe, Probemappen)
honorar_abrechner/windows_pruefung/
# Gegenprobe der Gewichtsschätzung: Bestandsdaten aus dem Shop
shopware_publisher/gewichte_pruefung.csv

# PI/BI: heavy sample binaries (keep xml + reference docx/html only)
pi_bi_generator/beispiele/**/*.pdf
pi_bi_generator/beispiele/**/*.xlsx
pi_bi_generator/beispiele/**/2D_300_*.jpg
pi_bi_generator/beispiele/**/3D_300_*.jpg
pi_bi_generator/beispiele/**/.~lock.*

# Cover-Previews: heavy local-only inputs (sample PDFs, mockup PSDs, Referenz-TIFs)
cover_previews/**/*.pdf
cover_previews/*.pdf
cover_previews/*.tif
cover_previews/mockups/*.psd
# 3D-Mockup-Vorlagen (~480 MB PSDs) — per config referenziert, nicht eingecheckt
cover_previews/_NEU_Vorlage/

# honorar_abrechner: die Altmappe und die Musterbriefe enthalten die
# Adressen und IBANs von rund 280 Autoren — personenbezogen, nur lokal.
honorar_abrechner/beispiele/

# LibreOffice / Office lock files
.~lock.*#
~$*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# shopware_publisher: Produkt-Dumps (nur lokal, zum Vergleich)
shopware_publisher/beispiel_produkt.json
shopware_publisher/dump_*.json
probelauf.txt
vergleich.txt
buchdurchgang/config.json
shopware_publisher/kategorien_*.json
buchdurchgang/kategorien_*.json

# jubilaeen_recherche: Abfrage-Cache und Ergebnisse sind jederzeit neu erzeugbar
jubilaeen_recherche/cache/
jubilaeen_recherche/*.sqlite
jubilaeen_recherche/*.csv
# … außer den Nachträgen: die sind Handarbeit (Belege aus Wikipedia), nicht neu erzeugbar
!jubilaeen_recherche/nachtraege.csv
jubilaeen_recherche/pakete/
jubilaeen_recherche/*_pruefliste.md
jubilaeen_recherche/*.log
jubilaeen_recherche/kontakte/

# presseverteiler: die Mappe nennt Journalisten samt Zuständigkeit, der
# Versandordner enthält ihre Anschriften — personenbezogen, nur vor Ort.
Presseverteiler.xlsx
Presseverteiler.neu.xlsx
Presseversand/
# … ebenso die Pakete und Ergebnisse der Einschätzung (Redaktionen samt
# Access-Bemerkungen) und die Sicherung der Mappe davor.
presseverteiler/einschaetzung/
# Die bisherigen Presselisten je Buch: Namen und Anschriften von Journalisten.
presseverteiler/training_data/
